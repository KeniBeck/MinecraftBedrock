# Dockerfile de producción del frontend BedrockPanel.
#
# Frontend = SPA React + TypeScript + Vite. En producción NO se sirve con
# uvicorn (eso es el backend): se compila a estáticos (`dist/`) y se entrega
# con nginx, que además hace de proxy inverso `/api` y `/ws` hacia el backend.
#
# Alineado a `apps/frontend/package.json` (pnpm) y a `vite.config.ts`
# (el proxy en dev reenvía `/api` y WS a :8000; aquí nginx replica ese contrato).
#
# Multi-stage:
#   - `builder`: instala (pnpm) + compila (`tsc -b && vite build`) → `dist/`.
#   - `runtime`: nginx-alpine sirve `dist/` con la config `nginx.conf`.

# Sincroniza con la versión de `node` requerida por el proyecto de portal.
ARG NODE_VERSION=22-alpine
ARG NGINX_VERSION=1.27-alpine

# --------------------------------------------------------------------------- #
# FASE BUILDER — dependencias + build del SPA
# --------------------------------------------------------------------------- #
FROM node:${NODE_VERSION} AS builder

WORKDIR /app

# Copia solo los manifiestos para cachear `pnpm install`.
COPY apps/frontend/package.json apps/frontend/pnpm-lock.yaml ./

# Activa Corepack y fija la versión de pnpm (lockfile v9) explícitamente,
# porque `package.json` no declara el campo `packageManager`.
RUN corepack enable && corepack prepare pnpm@9 --activate && pnpm install --frozen-lockfile

# Copia el resto del fuente y compila.
COPY apps/frontend/tsconfig.json apps/frontend/tsconfig.app.json \
     apps/frontend/tsconfig.node.json apps/frontend/vite.config.ts \
     apps/frontend/index.html apps/frontend/eslint.config.js apps/frontend/components.json ./
COPY apps/frontend/public ./public
COPY apps/frontend/src ./src

RUN pnpm build

# --------------------------------------------------------------------------- #
# FASE RUNTIME — nginx sirviendo el build + proxy al backend
# --------------------------------------------------------------------------- #
FROM nginx:${NGINX_VERSION} AS runtime

# Config de nginx (proxy /api + /ws al backend, SPA fallback, gzip, cache).
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

# El build de Vite genera `dist/`; nginx lo sirve como raíz web.
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]