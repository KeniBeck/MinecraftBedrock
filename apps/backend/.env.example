# Copia este archivo a `.env` y sustituye los placeholders por tus
# credenciales reales. `.env` NO se versiona (gitignore); `.env.example` sí.
#
# Misma URL que usa Alembic: sobrescribe `sqlalchemy.url` de `alembic.ini`
# cuando `BEDROCK_PANEL_DATABASE_URL` está definida en el entorno.
# En dev local, el contenedor `bedrockpanel-postgres` expone el puerto 5433.
BEDROCK_PANEL_DATABASE_URL=postgresql+psycopg://<usuario>:<password>@localhost:5433/bedrockpanel

# Pool de puertos por instancia (opcional; defaults: juego 19132–19181, RCON 25632–25681).
# Cada servidor usa un puerto base de juego y el siguiente (IPv6).
# BEDROCK_PANEL_SERVER_PORT_POOL_START=19132
# BEDROCK_PANEL_SERVER_PORT_POOL_END=19181
# BEDROCK_PANEL_SERVER_RCON_PORT_POOL_START=25632
# BEDROCK_PANEL_SERVER_RCON_PORT_POOL_END=25681

# Host o dominio que los jugadores usan para conectar (IP pública, LAN o DNS).
# BEDROCK_PANEL_SERVER_PUBLIC_HOST=localhost
