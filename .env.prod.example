# .env.prod.example — copia a `.env.prod` y sustituye los placeholders.
# Este archivo NO se versiona con secretos. Úsalo con:
#
#   cp .env.prod.example .env.prod      # y luego edita
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# ---- Postgres (produce la DB; NO son los defaults internos de dev) ----------
POSTGRES_USER=bedrockpanel
POSTGRES_PASSWORD=cambia-esta-contrasena-fuerte
POSTGRES_DB=bedrockpanel

# Puerto HOST para exponer Postgres (conectar con DBeaver/pgAdmin en
# localhost:{puerto}). Default 5432; cambia si ya lo ocupa otro Postgres.
BEDROCK_PANEL_PG_PORT=5432

# ---- Panel / backend --------------------------------------------------------
# URL del backend hacia la DB. En Docker se usa el nombre de servicio `postgres`.
# BEDROCK_PANEL_DATABASE_URL= (la arma el compose; no la definas salvo override)

# Host o IP que USAN LOS JUGADORES para conectar (LAN, IP pública o DNS).
BEDROCK_PANEL_SERVER_PUBLIC_HOST=localhost

# Ruta ABSOLUTA del host para los datos del panel (bind-mounts de Minecraft, worlds,
# backups, templates). DEBE coincidir con la ruta dentro del contenedor del backend
# para que los bind-mounts que crea docker-py apunten al mismo sitio.
BEDROCK_PANEL_STORAGE_ROOT=/var/lib/bedrockpanel/instances

# Clave Fernet (secrets de 2FA / backup codes de IAM). Generate una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BEDROCK_PANEL_IAM_ENCRYPTION_KEY=

# Clave HMAC de firma de los JWT de acceso (HS256). Opcional; sin ella se usa un
# fallback de desarrollo (PyJWT avisa de clave corta). Generate una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BEDROCK_PANEL_IAM_JWT_SECRET=

# ---- Bootstrap de administrador (super_admin) inicial ------------------------
# Si se definen usuario y contraseña, el backend crea UN super_admin en el primer
# arranque (idempotente: no sobrescribe si ya existe). Con estos entrarás al panel
# sin crear el usuario por comando.
BEDROCK_PANEL_BOOTSTRAP_ADMIN_USERNAME=admin
BEDROCK_PANEL_BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-contrasena-admin
BEDROCK_PANEL_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrador

# Opcional: workers de uvicorn (por defecto = 2 por CPU, máx 8).
# BEDROCK_PANEL_WEB_CONCURRENCY=

# Opcional: nivel de log del backend.
BEDROCK_PANEL_LOG_LEVEL=INFO

# ---- Frontend ---------------------------------------------------------------
# Puerto host al que mapear el HTTP del frontend (nginx :80).
BEDROCK_PANEL_HTTP_PORT=8080